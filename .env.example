# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini API Key (Server-side)
GEMINI_API_KEY=

# Optional CORS Allowed Origins (comma-separated, e.g. https://example.com)
ALLOWED_ORIGINS=

# Optional Model Overrides (Fully OPTIONAL - application uses hardcoded defaults with zero config)
# Format: comma-separated list of Gemini model IDs in priority order
# MODELS_DEEP_SEARCH=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest
# MODELS_TASHKEEL=gemini-3.8-flash,gemini-3.1-flash-lite,gemini-flash-latest
# MODELS_ART=gemini-3.1-flash-lite-image,gemini-nano-banana-2.1,gemini-3-pro-image
# MODELS_SPEECH=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
